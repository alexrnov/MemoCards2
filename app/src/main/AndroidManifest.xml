<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="alexrnov.animememo">

    <supports-screens android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:requiresSmallestWidthDp="320"/>

    <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name="alexrnov.animememo.Initialization"
        android:hardwareAccelerated="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.MemoCards">

        <uses-library android:name="android.test.runner" android:required="false" />
        <uses-library android:name="android.test.base" android:required="false" />
        <uses-library android:name="android.test.mock" android:required="false" />

        <activity
            android:name="alexrnov.animememo.view.activity.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name="alexrnov.animememo.view.activity.GameActivity"
            android:parentActivityName="alexrnov.animememo.view.activity.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="alexrnov.animememo.view.activity.MainActivity"/>
        </activity>

        <activity
            android:name="alexrnov.animememo.view.activity.SettingsActivity"
            android:parentActivityName="alexrnov.animememo.view.activity.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="alexrnov.animememo.view.activity.MainActivity"/>
        </activity>

        <activity
            android:name="alexrnov.animememo.view.activity.AboutGameActivity"
            android:parentActivityName="alexrnov.animememo.view.activity.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="alexrnov.animememo.view.activity.MainActivity"/>
        </activity>

        <activity
            android:name="alexrnov.animememo.view.statistics.StatisticsActivity"
            android:parentActivityName="alexrnov.animememo.view.activity.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="alexrnov.animememo.view.activity.MainActivity"/>
        </activity>

        <activity
            android:name="alexrnov.animememo.view.activity.FavoritesActivity"
            android:parentActivityName="alexrnov.animememo.view.activity.FavoritesActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="alexrnov.animememo.view.activity.MainActivity"/>
        </activity>

    </application>

</manifest>