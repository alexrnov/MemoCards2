<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/statisticsContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground"
    tools:context=".view.statistics.StatisticsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/statisticsAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/statistics"
        app:titleTextColor="@color/white"
        app:navigationIconTint="@color/white"
        app:titleTextAppearance="@style/ToolbarTitleStyle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@+id/statisticsAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginTop="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleDateContainer"
            android:layout_width="0dp"
            app:layout_constraintWidth_percent="0.4"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:onClick="sortByDate"
            android:background="@drawable/date_statistics_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/titleCardsContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/titleDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/title_date"
                android:textSize="14sp"
                android:textColor="@color/title_text"
                android:textAllCaps="true"
                android:typeface="sans"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleCardsContainer"
            android:layout_width="0dp"
            app:layout_constraintWidth_percent="0.3"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:onClick="sortByCards"
            android:background="@color/statistics_cards_head"
            app:layout_constraintStart_toEndOf="@+id/titleDateContainer"
            app:layout_constraintEnd_toStartOf="@+id/titleErrorsContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/titleCards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_cards"
                android:textSize="14sp"
                android:textColor="@color/title_text"
                android:textAllCaps="true"
                android:typeface="sans"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleErrorsContainer"
            android:layout_width="0dp"
            app:layout_constraintWidth_percent="0.3"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:onClick="sortByErrors"
            android:background="@drawable/right_statistics_title"
            app:layout_constraintStart_toEndOf="@+id/titleCardsContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/titleErrors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_errors"
                android:textSize="14sp"
                android:textColor="@color/title_text"
                android:textAllCaps="true"
                android:typeface="sans"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_transform"
        android:layout_height="0dp"
        android:name="alexrnov.animememo.view.statistics.StatisticsFragment"
        tools:layout="@layout/fragment_statistics"

        app:layout_constraintTop_toBottomOf="@+id/headContainer"
        app:layout_constraintBottom_toTopOf="@+id/clearStatisticsButton"
        android:layout_width="match_parent"
        android:layout_marginTop="0dp" />

    <Button
        android:id="@+id/clearStatisticsButton"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/clear_statistics"
        android:onClick="invokeConfirmDialog"
        android:textAllCaps="true"
        app:backgroundTint="@color/button_selector"
        app:layout_constraintTop_toBottomOf="@+id/nav_transform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ButtonStyle" />

    <TextView
        android:id="@+id/emptyTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/statistics_empty_text"
        android:textColor="@color/empty_text"
        android:textSize="17sp"
        android:typeface="sans"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/clearStatisticsButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statisticsAppBar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clearDialogBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blocked_background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/dialog_body"
            android:id = "@+id/clearStatisticsDialog"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:background="@drawable/dialog_head"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear_statistics"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textAllCaps="true"
                    android:fontFamily = "sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/textContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                app:layout_constraintBottom_toTopOf="@+id/buttons"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header">

                <TextView
                    android:id="@+id/question"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/statistics_dialog_text"
                    android:textSize="18sp"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="28dp"
                    android:textColor="@color/description_text"
                    android:gravity="center"
                    android:typeface="sans"
                    android:lineSpacingMultiplier="1.3"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <Button
                    android:id="@+id/clearButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="clearStatistics"
                    android:paddingBottom="15dp"
                    android:paddingTop="15dp"
                    android:text="@string/yes_button"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/button_selector"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/repeatGameButton"
                    android:layout_marginLeft="56dp"
                    android:layout_marginRight="28dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/ButtonStyle" />

                <Button
                    android:id="@+id/repeatGameButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="15dp"
                    android:paddingTop="15dp"
                    android:onClick="backToStatistics"
                    android:text="@string/no_button"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/button_selector"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginLeft="28dp"
                    android:layout_marginRight="56dp"
                    app:layout_constraintStart_toEndOf="@+id/clearButton"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/ButtonStyle" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>