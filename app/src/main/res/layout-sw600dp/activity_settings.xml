<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground"
    tools:context=".view.activity.SettingsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settingsAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/settings"
        app:titleTextColor="@color/white"
        app:navigationIconTint="@color/white"
        app:titleTextAppearance="@style/ToolbarTitleStyle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/settingsAppBar"
        app:layout_constraintBottom_toTopOf="@+id/centerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/radio_group"
            android:id="@+id/backgroundContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="36dp"
            app:layout_constraintTop_toTopOf="@+id/topContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/materialContainer">

            <TextView
                android:id="@+id/backgroundTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/background_title"
                android:textSize="18sp"
                android:textColor="@color/title_text"
                android:typeface="sans"
                android:layout_marginBottom="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/backgroundColorRadioGroup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <RadioGroup
                android:id="@+id/backgroundColorRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/backgroundTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/blackRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingLeft="6dp"
                    android:minHeight="46dp"
                    android:gravity="center_vertical"
                    android:text="@string/black_color"
                    android:textColor="@color/description_text"
                    android:textSize="16sp"
                    android:typeface="sans" />

                <RadioButton
                    android:id="@+id/grayRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingLeft="6dp"
                    android:minHeight="46dp"
                    android:gravity="center_vertical"
                    android:text="@string/gray_color"
                    android:textColor="@color/description_text"
                    android:textSize="16sp"
                    android:typeface="sans" />

                <RadioButton
                    android:id="@+id/whiteRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingLeft="6dp"
                    android:minHeight="46dp"
                    android:gravity="center_vertical"
                    android:text="@string/white_color"
                    android:textColor="@color/description_text"
                    android:textSize="16sp"
                    android:typeface="sans" />
            </RadioGroup>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/radio_group"
            android:id="@+id/materialContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="36dp"
            app:layout_constraintTop_toTopOf="@+id/topContainer"
            app:layout_constraintStart_toEndOf="@+id/backgroundContainer"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/materialTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/material_title"
                android:layout_marginBottom="4dp"
                android:textSize="18sp"
                android:textColor="@color/title_text"
                android:typeface="sans"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/materialRadioGroup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <RadioGroup
                android:id="@+id/materialRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/materialTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/stoneRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingLeft="6dp"
                    android:minHeight="46dp"
                    android:gravity="center_vertical"
                    android:text="@string/stone_material"
                    android:textColor="@color/description_text"
                    android:textSize="16sp"
                    android:typeface="sans" />

                <RadioButton
                    android:id="@+id/plasticRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingLeft="6dp"
                    android:minHeight="46dp"
                    android:gravity="center_vertical"
                    android:text="@string/plastic_material"
                    android:textColor="@color/description_text"
                    android:textSize="16sp"
                    android:typeface="sans" />

                <RadioButton
                    android:id="@+id/patternRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingLeft="6dp"
                    android:minHeight="46dp"
                    android:gravity="center_vertical"
                    android:text="@string/pattern_material"
                    android:textColor="@color/description_text"
                    android:textSize="16sp"
                    android:typeface="sans" />
            </RadioGroup>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/centerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/topContainer"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/radio_group"
            android:padding="36dp"
            android:id="@+id/cardSizeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@+id/centerContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/cardsQuantityTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cards_title"
                android:textSize="18sp"
                android:textColor="@color/title_text"
                android:typeface="sans"
                android:layout_marginBottom="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/cardsQuantityRadioGroup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <RadioGroup
                android:id="@+id/cardsQuantityRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/cardsQuantityTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/lowCardsRadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cards12"
                    android:paddingRight="15dp"
                    android:textColor="@color/description_text"
                    android:textSize="16sp"
                    android:typeface="sans" />

                <RadioButton
                    android:id="@+id/mediumCardsRadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cards16"
                    android:paddingRight="15dp"
                    android:textColor="@color/description_text"
                    android:textSize="16sp"
                    android:typeface="sans" />

                <RadioButton
                    android:id="@+id/manyCardsRadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cards20"
                    android:paddingRight="15dp"
                    android:textColor="@color/description_text"
                    android:textSize="16sp"
                    android:typeface="sans" />

                <RadioButton
                    android:id="@+id/maxCardsRadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cards30"
                    android:paddingRight="15dp"
                    android:textColor="@color/description_text"
                    android:textSize="16sp"
                    android:typeface="sans" />
            </RadioGroup>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/centerContainer"
        app:layout_constraintBottom_toTopOf="@+id/adsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/radio_group"
            android:padding="36dp"
            android:id="@+id/rotationSpeedContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@+id/bottomContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/rotationSpeedTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotation_speed_title"
                android:textSize="18sp"
                android:typeface="sans"
                android:textColor="@color/title_text"
                android:layout_marginBottom="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/rotationSpeedRadioGroup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <RadioGroup
                android:id="@+id/rotationSpeedRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/rotationSpeedTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/lowSpeedRadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lowSpeed"
                    android:paddingRight="15dp"
                    android:textColor="@color/description_text"
                    android:typeface="sans"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/mediumSpeedRadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mediumSpeed"
                    android:paddingRight="15dp"
                    android:textColor="@color/description_text"
                    android:typeface="sans"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/fastSpeedRadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fastSpeed"
                    android:paddingRight="15dp"
                    android:textColor="@color/description_text"
                    android:typeface="sans"
                    android:textSize="16sp" />
            </RadioGroup>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adsContainer"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/statistics_cards_head"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
    </androidx.constraintlayout.widget.ConstraintLayout>
    -->
</androidx.constraintlayout.widget.ConstraintLayout>
