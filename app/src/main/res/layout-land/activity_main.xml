<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground"
    tools:context=".view.activity.MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mainAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/app_name"
        app:contentInsetStart="2dp"
        app:contentInsetStartWithNavigation="0dp"
        app:logo="@mipmap/ic_launcher"
        app:navigationIcon="@null"
        app:titleMarginStart="5dp"
        app:titleCentered="true"
        app:titleTextColor="@color/white"
        app:titleTextAppearance="@style/ToolbarTitleStyle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/mainAppBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="3"
            android:rowCount="1">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_height="match_parent"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnWeight="1">

                <Button
                    android:id="@+id/gameButton"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:text="@string/start_game"
                    android:textAllCaps="true"
                    android:maxLines="1"
                    app:backgroundTint="@color/game_button_selector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/statisticsButton"
                    style="@style/ButtonStyle" />

                <Button
                    android:id="@+id/statisticsButton"
                    style="@style/ButtonStyle"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:text="@string/statistics"
                    android:textAllCaps="true"
                    android:maxLines="1"
                    app:backgroundTint="@color/button_selector"
                    app:layout_constraintTop_toBottomOf="@+id/gameButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_height="match_parent"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_columnWeight="1">

                <Button
                    android:id="@+id/favoritesButton"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:text="@string/favorites"
                    android:textAllCaps="true"
                    android:maxLines="1"
                    app:backgroundTint="@color/button_selector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/aboutGameButton"
                    style="@style/ButtonStyle" />

                <Button
                    android:id="@+id/aboutGameButton"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:text="@string/about_game"
                    android:textAllCaps="true"
                    android:maxLines="1"
                    app:backgroundTint="@color/button_selector"
                    app:layout_constraintTop_toBottomOf="@+id/favoritesButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    style="@style/ButtonStyle" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_height="match_parent"
                android:layout_row="0"
                android:layout_column="2"
                android:layout_columnWeight="1">

                <Button
                    android:id="@+id/settingsButton"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:text="@string/settings"
                    android:textAllCaps="true"
                    android:maxLines="1"
                    app:backgroundTint="@color/button_selector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/exitButton"
                    style="@style/ButtonStyle" />

                <Button
                    android:id="@+id/exitButton"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:text="@string/exit"
                    android:textAllCaps="true"
                    android:maxLines="1"
                    android:onClick="exit"
                    app:backgroundTint="@color/button_selector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/settingsButton"
                    app:layout_constraintBottom_toBottomOf="parent"
                    style="@style/ButtonStyle" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </GridLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
